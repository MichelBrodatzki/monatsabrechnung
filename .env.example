DATABASE_PATH=./data/monatsabrechnung.db

# Optionaler einfacher Zugriffsschutz. Beide Werte müssen gesetzt sein.
APP_USERNAME=
APP_PASSWORD=

# Optionaler OIDC-Zugriffsschutz. Wenn OIDC_ISSUER gesetzt ist, müssen auch
# Client-ID, Client-Secret, Gruppen-Claim und erlaubte Gruppen gesetzt sein.
# OIDC hat Vorrang vor APP_USERNAME/APP_PASSWORD.
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_REDIRECT_URI=
OIDC_GROUPS_CLAIM=groups
OIDC_ALLOWED_GROUPS=
OIDC_SCOPES=openid profile email
OIDC_CLIENT_AUTH_METHOD=client_secret_basic
OIDC_SESSION_TTL_SECONDS=43200
